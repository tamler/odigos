# Odigos Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM Provider Keys ───────────────────────────────────────────────
# Define one env var per provider you want Odigos to use, then reference
# them from config.yaml's `providers:` block as ${OPENROUTER_API_KEY} etc.
# Provider base_urls and model choices are configured in config.yaml,
# not here — this file only holds secrets.
OPENROUTER_API_KEY=your-openrouter-key
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Authentication (required) ───────────────────────────────────────
# API key for authenticating dashboard and API access.
# install.sh generates one automatically if not set.
API_KEY=

# ── Server ──────────────────────────────────────────────────────────
# Port the Odigos server listens on inside the container
ODIGOS_PORT=8000

# ── TLS / Reverse Proxy ────────────────────────────────────────────
# Domain name for automatic HTTPS via Caddy (e.g. agent.example.com).
# Leave as localhost for local development (self-signed cert).
ODIGOS_DOMAIN=localhost

# ── Telegram (optional) ────────────────────────────────────────────
# Uncomment and set to enable the Telegram bot channel
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
