# Odigos Configuration
# Copy this to config.yaml and fill in your values.
# Docs: https://github.com/msitarzewski/odigos

# =============================================================================
# SECRETS & API KEYS
# =============================================================================

# API key for authenticating dashboard and API requests.
# api_key: "your-secret-api-key-here"

# LLM provider API keys live in the `providers:` block below — either as
# literal values or as ${ENV_VAR} references pulled from .env at load time.

# Session secret for web auth (auto-generated if not set)
# session_secret: ""

# External services — one key per provider, auto-enables all capabilities.
# Set a key and the features it powers just work. No "enabled: true" needed.
# services:
#   kie_ai: ""          # Image gen (Z-Image) + Music gen (Suno)
#   groq: ""            # Whisper STT for voice input
#   brave: ""           # Brave web search
#   telegram: ""        # Telegram bot channel
#   notebooklm: ""      # NotebookLM integration

# Search provider (if using SearxNG instead of Brave)
# search_provider: "searxng"
# searxng_url: "http://searxng:8080"
# searxng_username: ""
# searxng_password: ""

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Agent identity and behavior
agent:
  name: "Odigos"
  role: "personal_assistant"        # Role identifier for the agent
  description: ""                   # Optional description shown in UI
  # parent: ""                      # Parent agent name (for child agents)
  # allow_external_evaluation: false
  max_tool_turns: 15                # Max tool calls per conversation turn (Starter tier; raise to 25 for power users)
  run_timeout_seconds: 180          # Timeout for a single agent run
  cite_sources: true                # Include source citations in responses
  concise_mode: false               # Shorter responses when true

# Database
database:
  path: "data/odigos.db"

# =============================================================================
# LLM: providers, models, and routing
# =============================================================================
#
# Define each provider once. Define each model once with its provider, id, cost,
# and capabilities. Route intelligence tiers (fast/smart/background/fallback)
# to models by alias.
#
# Adding a second provider is one yaml block. Switching your default model is
# one line in the `llm` block. Costs travel with the model definition so they
# never drift from the model they describe.
#
# Examples of provider base_urls:
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1

providers:
  openrouter:
    base_url: "https://openrouter.ai/api/v1"
    api_key: "${OPENROUTER_API_KEY}"   # ${ENV_VAR} resolved from .env

models:
  scout:
    provider: openrouter
    id: "meta-llama/llama-4-scout"
    cost_in_per_mtok: 0.08
    cost_out_per_mtok: 0.30
    vision: true
    context_window: 131072
    notes: "Cheap + vision default"
  deepseek-v3.2:
    provider: openrouter
    id: "deepseek/deepseek-v3.2"
    cost_in_per_mtok: 0.27
    cost_out_per_mtok: 1.10
    vision: false
    context_window: 163840
    notes: "Reasoning tier"
  gpt-5-nano:
    provider: openrouter
    id: "openai/gpt-5-nano"
    cost_in_per_mtok: 0.05
    cost_out_per_mtok: 0.40
    vision: false
    context_window: 128000
    notes: "Emergency fallback"

llm:
  fast: scout               # Default for most actions
  smart: deepseek-v3.2      # Reasoning-heavy work (planning, document queries)
  background: scout         # Heartbeat / background loops (defaults to fast)
  fallback: gpt-5-nano      # Safety net if primary fails
  max_tokens: 16384         # Global cap on output tokens. Per-model max_output_tokens (in models: block) clamps lower when needed.
  temperature: 0.7
  request_timeout_seconds: 60
  connect_timeout_seconds: 10
  auto_route: true          # Let the classifier pick the tier automatically

# Budget limits — tuned for Starter-tier hosted use. Personal users running
# locally can loosen these freely; hosted operators should keep them tight
# because the agent will auto-downgrade to the `background` tier near the cap.
budget:
  daily_limit_usd: 0.50
  monthly_limit_usd: 10.00
  warn_threshold: 0.80              # Warn at 80% of budget consumed

# Web server
server:
  host: "0.0.0.0"
  port: 8000
  ws_port: 8001

# =============================================================================
# BACKGROUND PROCESSING
# =============================================================================

# Heartbeat (autonomous background loop) — Starter defaults favor quieter,
# cheaper background work. Raise for heavy personal use.
heartbeat:
  interval_seconds: 60              # Seconds between heartbeat ticks
  max_todos_per_tick: 2             # Max todo items processed per tick
  idle_think_interval: 0            # 0 = disable idle autonomous thinking (cheapest)
  announce_interval_seconds: 60     # Seconds between status announcements
  morning_briefing: false           # Disabled by default — opt in per tier

# Proactive autonomous research — OFF by default on Starter. When enabled,
# the agent scans brain gaps / recent conversations and proposes research
# opportunities for the user to approve. Big value for Pro tier, expensive
# for Starter.
proactive:
  enabled: false
  interval_seconds: 900
  max_cycles_per_hour: 4
  max_per_cycle: 1

# =============================================================================
# EMBEDDINGS
# =============================================================================

# Embedding model configuration
# embeddings:
#   mode: "auto"                    # "auto" (detect toolkit), "local" (in-process), or "remote" (shared service)
#   remote_url: "http://localhost:9000"

# =============================================================================
# FEATURES
# =============================================================================

# Notebooks (markdown documents)
notebooks:
  enabled: true

# Kanban board
kanban:
  enabled: true

# Agent templates repository
# templates:
#   repo_url: "https://github.com/msitarzewski/agency-agents"
#   cache_ttl_days: 7

# =============================================================================
# TOOLS & SANDBOX
# =============================================================================

# File tool access paths
file_access:
  allowed_paths:
    - "data/files"

# Code sandbox
sandbox:
  timeout_seconds: 5
  max_memory_mb: 512
  allow_network: false

# Skills directory
skills:
  path: "skills"

# Tool approval gate
approval:
  enabled: true                     # Require approval for dangerous tools
  tools:                            # Tools that require approval
    - "run_code"
    - "run_shell"
    - "write_file"
  timeout: 300                      # Seconds to wait for approval

# =============================================================================
# EVOLUTION ENGINE
# =============================================================================

# Self-improvement through prompt/behavior trials
evolution:
  trial_duration_hours: 48
  min_evaluations: 5
  promote_threshold: 0.5
  revert_threshold: -0.3
  auto_trial_confidence: 0.7
  strategist_min_evals: 10
  qualified_evaluator_min_score: 7.0

# =============================================================================
# VOICE (optional)
# =============================================================================

# Voice input/output configuration
# voice:
#   stt_provider: "groq"            # "groq", "local" (moonshine), or "disabled"
#   tts_provider: "edge"            # "edge" (edge-tts), "local" (pocket-tts), or "disabled"
#   tts_voice: "en-US-AriaNeural"   # edge-tts voice name
#   groq_model: "whisper-large-v3-turbo"

# Legacy STT/TTS toggles (prefer voice section above)
# stt:
#   enabled: false
#   model: "small"
#   language: "en"
# tts:
#   enabled: false
#   voice: "alba"

# =============================================================================
# ASSISTANT WIDGET (optional)
# =============================================================================

# Floating assistant overlay in the dashboard
# assistant:
#   enabled: true
#   show_transcript: true
#   text_input: true
#   voice_input: true
#   auto_read: false                # Automatically read responses aloud
#   position: "bottom-right"        # "bottom-right" or "bottom-left"

# =============================================================================
# CALENDAR (optional)
# =============================================================================

# Calendar -- connect any CalDAV provider (Google, Apple iCloud, Outlook, Fastmail, Nextcloud, etc.)
# calendar:
#   enabled: false
#   url: "https://caldav.example.com/user/calendar"  # Your provider's CalDAV URL
#   username: ""
#   password: ""

# =============================================================================
# EMAIL (optional)
# =============================================================================

# IMAP/SMTP email integration
# Email -- connect any SMTP/IMAP provider (Gmail, Outlook, Fastmail, ProtonMail, etc.)
# email:
#   enabled: false
#   address: "you@gmail.com"
#   imap_host: "imap.gmail.com"           # Your provider's IMAP server
#   imap_port: 993
#   smtp_host: "smtp.gmail.com"           # Your provider's SMTP server
#   smtp_port: 587
#   username: "you@gmail.com"
#   password: "app-specific-password"     # Use app passwords, not your main password
#   check_interval_ticks: 10              # Heartbeat ticks between inbox checks
#   check_interval_ticks: 10        # Heartbeat ticks between inbox checks (0 = agent decides)

# =============================================================================
# CHANNELS (optional)
# =============================================================================

# Telegram bot
# telegram:
#   mode: "polling"                 # "polling" or "webhook"
#   webhook_url: ""                 # Required if mode is "webhook"

# =============================================================================
# EXTERNAL TOOLS (optional)
# =============================================================================

# Google Workspace CLI (requires gcloud setup)
gws:
  enabled: false
  # timeout: 30

# Agent Browser CLI
browser:
  enabled: false
  # timeout: 120

# MCP servers (Model Context Protocol)
# mcp:
#   servers:
#     myserver:
#       command: "npx"
#       args: ["-y", "@my/mcp-server"]
#       env: {}

# =============================================================================
# AGENT MESH (optional)
# =============================================================================

# Multi-agent networking via NetBird
# mesh:
#   enabled: false

# Peer agents (requires mesh.enabled: true)
# peers:
#   - name: "researcher"
#     netbird_ip: "100.64.0.2"
#     ws_port: 8001
#     api_key: "peer-secret"

# =============================================================================
# FEED (optional)
# =============================================================================

# Public activity feed
# feed:
#   enabled: false
#   public: false                   # Expose feed without authentication
#   max_entries: 200

# =============================================================================
# ACCESS CONTROL (optional)
# =============================================================================

# Access mode
# access:
#   supervised: false               # true = managed agent (protected settings locked), false = full admin

# =============================================================================
# AUTO-UPDATE (optional)
# =============================================================================

# Automatic update checking and application
# auto_update:
#   enabled: false
#   check_interval_ticks: 60        # Heartbeat ticks between checks (~30min at 30s interval)
#   auto_apply: false               # true = apply immediately, false = notify only
#   branch: "main"

# Kie.ai media generation (image + music) — one key enables both
# Get an API key at https://kie.ai/api-key
# Set the key in EITHER section — it's shared automatically.
# image_generation:
#   api_key: ""                       # Kie.ai API key
#   default_aspect_ratio: "1:1"       # 1:1, 4:3, 3:4, 16:9, 9:16
#   nsfw_filter: true
#   max_poll_seconds: 120
#
# music_generation:                   # Auto-enabled when a Kie.ai key exists
#   provider: "suno"                  # Kie.ai provider name
#   task_type: "suno_music"           # Kie.ai taskType
#   model: "V5"                       # V5, V5_5, V4_5PLUS, V4_5, V4
#   max_poll_seconds: 180

# Storage quota -- monitor per-agent disk usage
# storage:
#   warn_gb: 10.0                     # Notify user when data/ exceeds this
#   cap_gb: 12.0                      # Soft cap -- block new writes above this
